{
  "name": "F1 Tipovačka",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "F1 Tipovačka",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup env DEMO_PORT=8080 python demo.py >/tmp/f1-demo.log 2>&1 </dev/null &"
}
